# Packages pre-built binaries produced by the CI runner.
# Binaries must be built before docker build is called:
#   CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-s -w" -trimpath -o point-mcp-amd64 ./cmd/point-mcp
#   CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -ldflags="-s -w" -trimpath -o point-mcp-arm64 ./cmd/point-mcp

ARG TARGETARCH=amd64

FROM alpine:3.22 AS certs
RUN apk add --no-cache ca-certificates

FROM scratch
ARG TARGETARCH
COPY --from=certs /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY point-mcp-${TARGETARCH} /point-mcp
ENTRYPOINT ["/point-mcp"]
