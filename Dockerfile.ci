# Packages a pre-built binary produced by the CI runner.
# The binary must be built before docker build is called:
#   CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-s -w" -trimpath -o point-mcp ./cmd/point-mcp

FROM alpine:3.22 AS certs
RUN apk add --no-cache ca-certificates

FROM scratch
COPY --from=certs /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY point-mcp /point-mcp
ENTRYPOINT ["/point-mcp"]
