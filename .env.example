# Required: base URL of your Point instance
# POINT_BASE_URL=https://your-point-instance.example.com

# Required: API key for authenticating with Point
# POINT_API_KEY=your-api-key-here

# Optional: transport mode — "stdio" (default) or "http"
# POINT_MCP_TRANSPORT=stdio

# Optional: listen address when using HTTP transport (default :8000)
# POINT_MCP_HTTP_ADDR=:8000

# Optional: path to a log file; when set, logs are written to both stderr and this file
# POINT_MCP_LOG_FILE=point-mcp.log
